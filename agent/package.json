{
  "name": "@forge/agent",
  "version": "0.0.0",
  "private": true,
  "description": "Mastra app for the VideoDB Growth Agent — agents, workflows, scorers, tools, strategy, snippets.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./strategy": "./src/mastra/strategy/index.ts",
    "./snippets": "./src/snippets/registry.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "loop": "tsx scripts/run-discovery.ts",
    "dispatch": "tsx scripts/run-dispatcher.ts",
    "attribute": "tsx scripts/run-attribution.ts",
    "purge": "tsx scripts/run-purge.ts",
    "forget-user": "tsx scripts/forget-user.ts",
    "preflight": "tsx scripts/preflight.ts",
    "cron": "tsx scripts/run-cron.ts",
    "seed:experiments": "tsx scripts/seed-experiments.ts",
    "validate:snippets": "tsx scripts/validate-snippets.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.41.0",
    "@mastra/libsql": "^1.12.1",
    "@mastra/memory": "^1.20.2",
    "@mastra/pg": "^1.12.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "drizzle-orm": "^0.45.2",
    "exa-js": "^2.13.0",
    "fastembed": "^2.1.0",
    "parallel-web": "^1.1.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "mastra": "^1.12.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
