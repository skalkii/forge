# Copy to .env at the repo root. Both agent/ and dashboard/ read this file.
# Never commit .env.

# --- Dashboard / review queue (R6: fails closed if unset) ---
# Random high-entropy string; gates every dashboard route + API.
#   openssl rand -hex 32
REVIEW_QUEUE_SECRET=

# --- Postgres (local: make db-up) ---
DATABASE_URL=postgres://forge:forge@localhost:5432/forge
