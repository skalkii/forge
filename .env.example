# Copy to .env at the repo root. Both agent/ and dashboard/ read this file.
# Never commit .env.

# --- Dashboard / review queue (R6: fails closed if unset) ---
# Random high-entropy string; gates every dashboard route + API.
#   openssl rand -hex 32
REVIEW_QUEUE_SECRET=

# --- Postgres (local: make db-up) ---
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# --- AI models (Mastra router provider/model form; legacy provider:model accepted) ---
CHEAP_MODEL=             # e.g. anthropic/claude-haiku-4-5, ollama/qwen2.5-coder:7b
STRONG_MODEL=            # e.g. anthropic/claude-sonnet-4-6, deepseek/deepseek-chat
# Provider credentials — set only the ones you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
DASHSCOPE_API_KEY=       # qwen/* hosted models
OPENROUTER_API_KEY=      # openrouter/* — one key, many models incl. :free tiers
OLLAMA_BASE_URL=         # default http://localhost:11434

# --- GitHub (R4: dual rate budgets, read live from headers) ---
# Auth resolution order: GITHUB_TOKEN (PAT, dev) → GitHub App → unauthenticated (60/hr).
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # \n-escaped PEM accepted
GITHUB_APP_INSTALLATION_ID=
GITHUB_POST_AS=                  # human account used for public replies — never a bot

# --- Metric strategy (the only metric-specific code) ---
METRIC_STRATEGY=github-usage

# --- Touch safety (R3) ---
# Affiliation line every public touch must contain verbatim; spam-guardrail
# hard-fails drafts missing it. Sensible default ships in code
# (lib/disclosure.ts); VideoDB's preferred wording → OPEN_QUESTIONS.md.
DISCLOSURE_TEXT=

# --- VideoDB (offline snippet validator only — never in the request path) ---
# SDK also reads VIDEO_DB_API_KEY; validator accepts either.
VIDEODB_API_KEY=

# --- Research / enrichment (demand-driven, post-triage only) ---
EXA_API_KEY=
PARALLEL_API_KEY=
RETRIEVAL_DAILY_BUDGET_USD=2         # combined exa+parallel cap; fails closed when hit
EXA_COST_PER_SEARCH_USD=0.005        # estimate; Exa's actual costDollars used when returned
PARALLEL_COST_PER_SEARCH_USD=0.005   # estimate — verify against current pricing (R10)

# --- Cost telemetry ---
# Optional override; defaults to <repo root>/submission/spend-and-efficiency.csv
SPEND_CSV_PATH=

# --- Workflow gates ---
TRIAGE_THRESHOLD=0.6           # min triage score to enqueue a candidate
QUALIFY_THRESHOLD=0.7          # min qualify fit to proceed to craft
# LLM token→USD conversion for cost_events (USD per million tokens; 0 = free tier)
LLM_COST_PER_MTOK_IN=0
LLM_COST_PER_MTOK_OUT=0
